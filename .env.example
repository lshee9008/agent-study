# ===== 모델 (NVIDIA API, 오픈소스 모델) =====
# build.nvidia.com 로그인 → 오른쪽 위 프로필 → API Keys → Generate API Key (nvapi-로 시작)
NVIDIA_API_KEY=
# 툴 콜링 되는 오픈소스 모델. 바꿀 땐 build.nvidia.com 모델 ID 그대로 입력
# 이 계정에서 툴 콜링 확인됨(2026-10-24): z-ai/glm-5.3-flash, deepseek-ai/deepseek-v4.1-flash, minimaxai/minimax-m3.1-flash, openai/gpt-oss-20b
NVIDIA_MODEL=z-ai/glm-5.3-flash

# ===== GitHub =====
# Fine-grained PAT, 대상 레포에 Contents/Metadata/Issues/Pull requests "Read-only"
GITHUB_PAT=

# ===== Notion =====
# notion.so/profile/integrations 에서 Internal integration 생성 후 토큰
# 정리할 페이지/DB에서 "연결(Connections)"로 이 integration 추가 필수
NOTION_TOKEN=

# ===== Velog (비공식 API, 브라우저 쿠키 값) =====
# velog.io 로그인 → 개발자도구 → Application → Cookies → access_token / refresh_token
# refresh_token 유효기간 약 30일 → 만료되면 갱신 후 ./scripts/render-config.sh 재실행
VELOG_ACCESS_TOKEN=
VELOG_REFRESH_TOKEN=

# ===== 실행 조건 (맥이 켜져 있을 때만) =====
RUN_INTERVAL_DAYS=7       # 마지막 성공 후 며칠 지나면 다시 실행할지
REQUIRE_AC_POWER=true     # 충전기 연결 상태에서만 실행 (배터리 보호)
